{
  "name": "dsh-client",
  "version": "0.2.0",
  "private": true,
  "description": "DSH Client — 桌面端 DeepSeek Harness（Electron 窗口嵌入官方网页界面）",
  "author": "DSH Client",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "test": "node test-dom-jsdom.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "app-builder-bin": "^4.2.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.0.1",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.dshclient.app",
    "productName": "DSH CLIENT",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${target}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH CLIENT",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
